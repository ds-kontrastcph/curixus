{
	"name": "curixus/impact-metrics",
	"title": "Impact Metrics",
	"description": "Metrics strip with highlighted statistics.",
	"category": "curixus",
	"icon": "chart-bar",
	"keywords": ["metrics", "stats", "impact", "numbers"],
	"acf": {
		"mode": "preview",
		"blockVersion": 3,
		"renderTemplate": "block-render.php"
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"align": ["full"],
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": false,
			"gradients": false,
			"link": false
		},
		"dimensions": {
			"minHeight": false
		},
		"position": {
			"sticky": false
		}
	},
	"style": ["file:./style.css"]
}
